# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=Europe/Kyiv
LANGUAGE_CODE=ru
LOG_LEVEL=INFO
SECURE_SSL_REDIRECT=False

# PostgreSQL
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio-postgres-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://studio:studio-postgres-password@postgres:5432/studio
DB_CONN_MAX_AGE=60

# Redis and Celery
REDIS_PASSWORD=studio-redis-password
REDIS_PORT=6380
CELERY_LOG_LEVEL=INFO
CELERY_TASK_TIME_LIMIT=1800

# JWT
JWT_SIGNING_KEY=replace-with-a-separate-long-random-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# MinIO / S3
USE_S3=True
MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=studio-minio-password
MINIO_BUCKET_NAME=studio-media
MINIO_ENDPOINT=http://minio:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_S3_REGION_NAME=us-east-1

# Flower
FLOWER_BASIC_AUTH=admin:change-me
FLOWER_PORT=5555

# HTTP
HTTP_PORT=8080

# Sentry (disabled unless both values are set)
SENTRY_ENABLED=False
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Production email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Studio <noreply@example.com>"

# Telegram bot
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_WEBHOOK_URL=
TASK_REMINDER_HOUR=9
